.progress-wrap {
  margin-bottom: 24rpx;
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.axis-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.progress-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #6B7280;
}

.progress-track {
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

.quiz-card {
  padding: 36rpx 32rpx;
}

.question-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.48;
  margin-bottom: 24rpx;
}

.roast-box {
  background: #F8FAFC;
  border-left: 8rpx solid #33A474;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.roast-badge {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.roast-text {
  font-size: 27rpx;
  color: #374151;
  line-height: 1.55;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.option-dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid #9CA3AF;
  flex-shrink: 0;
}

.option-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.quiz-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  min-height: 88rpx;
}

.prev-btn {
  flex: 0 0 34%;
}

.skip-btn {
  flex: 1;
}

.back-btn {
  width: 100%;
}

.draft-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 18rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.draft-text {
  font-size: 24rpx;
  color: #92400E;
  font-weight: 600;
}

.draft-reset {
  font-size: 24rpx;
  color: #B45309;
  font-weight: 800;
  text-decoration: underline;
}
