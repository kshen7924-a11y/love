.container {
  padding-top: 20rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.hero-banner {
  background: linear-gradient(120deg, #2FA57D 0%, #1F8C8C 100%);
  border-radius: 30rpx;
  padding: 32rpx 28rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.brand-pill {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.18);
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 6rpx;
}

.hero-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.2;
}

.hero-art {
  width: 130%;
  height: 280rpx;
  margin-left: -15%;
  margin-top: 6rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 50rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
}

.entry-left {
  flex: 1;
}

.entry-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 10rpx;
}

.tag-green {
  background: #E8F6F0;
  color: #25855D;
}

.tag-blue {
  background: #EAF5F8;
  color: #2E7A93;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #111827;
  margin-bottom: 10rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.4;
}

.entry-right {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-icon {
  width: 128rpx;
  height: 128rpx;
}

.entry-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-green {
  background: #E8F6F0;
  color: #33A474;
}

.badge-blue {
  background: #EAF5F8;
  color: #4298B4;
}

.quick-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F9FAFB;
  padding: 26rpx 32rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
}

.quick-label {
  font-size: 20rpx;
  color: #6B7280;
}

.quick-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #111827;
  margin-top: 2rpx;
}

.quick-arrow {
  font-size: 24rpx;
  font-weight: 700;
  color: #33A474;
}

.theory-footer {
  margin-top: 44rpx;
  padding: 0 4rpx;
}

.theory-title {
  font-size: 21rpx;
  font-weight: 700;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.theory-footer .muted-note {
  font-size: 20rpx;
  line-height: 1.55;
}
